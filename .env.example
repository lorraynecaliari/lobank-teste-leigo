# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).

# Credenciais de SANDBOX da Celcoin (painel da Celcoin ou cel_agents).
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=

# Sempre o sandbox. O app se recusa a iniciar apontando para produção.
CELCOIN_BASE_URL=https://sandbox.openfinance.celcoin.dev

# sandbox = fala com a Celcoin de verdade (padrão)
# mock    = simulação local para desenvolvimento; o app mostra a faixa "MODO SIMULADO"
CELCOIN_MODE=sandbox

PORT=3000
# DATABASE_FILE=./data/lobank.db

# Intervalo mínimo entre consultas iguais à Celcoin, em ms (padrão 10000 = 10 s).
# Dentro do intervalo o app reaproveita a última resposta e não chama a API.
# CELCOIN_MIN_QUERY_INTERVAL_MS=10000

# DDA: os avisos da Celcoin (adesão, saída e boletos) só chegam por webhook. No sandbox, eles vão
# para um webhook.site e o app lê de lá. Coloque aqui só o identificador (o que vem depois de
# https://webhook.site/). Esse endereço é público: use apenas no sandbox.
# DDA_WEBHOOK_SITE_TOKEN=
# Minutos sem aviso até o app parar de esperar um pedido de adesão ou saída do DDA (padrão 10: no sandbox a Celcoin diz que o aviso leva até 10 min).
# DDA_PENDING_TIMEOUT_MIN=10

# Evidências para o QA do cel_agents: com EVIDENCIAS=1, cada chamada que o app faz à Celcoin
# (e cada aviso do DDA recebido) é gravada, MASCARADA, em data/evidencias/AAAA-MM-DD.jsonl.
# Token, credenciais e senhas nunca entram. A pasta data/ fica fora do Git.
# Relatório em Markdown: node tools/evidencias.js AAAA-MM-DD
# EVIDENCIAS=1
# EVIDENCIAS_DIR=./data/evidencias

# Webhooks do BaaS (Pix enviado/recebido, devoluções, criação de conta). O app trata os avisos
# em POST /webhooks/celcoin e também os que estiverem no mesmo webhook.site do DDA.
# Se o cadastro do webhook na Celcoin usar autenticação básica, repita usuário e senha aqui.
# CELCOIN_WEBHOOK_USER=
# CELCOIN_WEBHOOK_PASSWORD=

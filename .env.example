# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).

# Credenciais de SANDBOX da Celcoin (painel da Celcoin ou cel_agents).
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=

# Sempre o sandbox. O app se recusa a iniciar apontando para produção.
CELCOIN_BASE_URL=https://sandbox.openfinance.celcoin.dev

# sandbox = fala com a Celcoin de verdade (padrão)
# mock    = simulação local para desenvolvimento; o app mostra a faixa "MODO SIMULADO"
CELCOIN_MODE=sandbox

PORT=3000
# DATABASE_FILE=./data/lobank.db

# Intervalo mínimo entre consultas iguais à Celcoin, em ms (padrão 10000 = 10 s).
# Dentro do intervalo o app reaproveita a última resposta e não chama a API.
# CELCOIN_MIN_QUERY_INTERVAL_MS=10000
